{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "categories": { "correctness": "error" },
  "env": { "browser": true, "node": true, "es2024": true },
  "ignorePatterns": ["dist/**", "public/**", ".cache/**", "node_modules/**"],
  "rules": {
    "unicorn/prefer-string-starts-ends-with": "off",
    "eslint/no-unused-expressions": ["error", { "allowShortCircuit": true, "allowTernary": true }],
    "eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }]
  },
  "overrides": [
    { "files": ["scripts/e2e-*.mjs"], "rules": { "eslint/no-eval": "off" } },
    { "files": ["scripts/lib/*.mjs"], "rules": { "eslint/no-unused-expressions": "off", "eslint/no-control-regex": "off" } }
  ]
}
