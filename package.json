{
  "name": "real-state-3d-web-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data": "npm run data:download && npm run data:region && npm run data:cadastre && npm run data:heights && npm run data:tiles && npm run data:listings && npm run data:developments",
    "data:download": "node scripts/download-osm.mjs",
    "data:region": "python3 scripts/extract-region.py",
    "data:cadastre": "node scripts/download-cadastre.mjs",
    "data:heights": "node scripts/estimate-heights.mjs",
    "data:tiles": "node --max-old-space-size=6144 scripts/build-tiles.mjs",
    "map:changes": "node scripts/map-changes.mjs",
    "data:listings": "node scripts/generate-listings.mjs",
    "data:developments": "node scripts/generate-developments.mjs",
    "validate:data": "node scripts/validate-listings.mjs",
    "listings:add": "node scripts/add-listings.mjs",
    "verify:e2e": "node scripts/e2e-check.mjs",
    "test:backend": "node scripts/test-backend.mjs",
    "db:start": "supabase start -x realtime,studio,imgproxy,logflare,vector,supavisor,postgres-meta,mailpit",
    "db:reset": "supabase db reset",
    "verify:backend": "node scripts/e2e-backend.mjs",
    "import:xml": "node scripts/import-xml.mjs",
    "verify:site": "node scripts/e2e-site.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@turf/area": "^7.4.0",
    "@turf/bbox": "^7.4.0",
    "@turf/bearing": "^7.4.0",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/centroid": "^7.4.0",
    "@turf/circle": "^7.4.0",
    "@turf/destination": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0",
    "@turf/transform-rotate": "^7.4.0",
    "maplibre-gl": "^6.13.0",
    "pmtiles": "^4.5.0",
    "polygon-clipping": "^0.15.7",
    "suncalc": "^2.1.1"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@turf/point-on-feature": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "axe-core": "^4.14.0",
    "fast-xml-parser": "^5.11.2",
    "geojson-vt": "^4.0.3",
    "pbf": "^5.1.2",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "supabase": "^2.120.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vt-pbf": "^3.1.3"
  }
}
